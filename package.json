{
  "jest": {
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "moduleDirectories": [
      "<rootDir>/node_modules",
      "<rootDir>/src"
    ],
    "roots": [
      "<rootDir>/src"
    ],
    "setupFiles": [
      "<rootDir>/src/utils/tests/setup.js"
    ],
    "transformIgnorePatterns": [],
    "transform": {
      ".*\\.ts$": "<rootDir>/src/utils/tests/jest.js",
      ".*\\.tag.html$": "<rootDir>/src/utils/tests/tag.js",
      ".*\\.(sass|svg|png)$": "<rootDir>/src/utils/tests/asset.js"
    },
    "testMatch": [
      "**/*.test.(js|ts)"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/*.test.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      }
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "dependencies": {
    "include-media": "^1.4.9",
    "lodash": "^4.17.11",
    "microtip": "^0.2.2",
    "redux": "^4.0.1",
    "redux-code": "^0.1.6",
    "redux-riot": "^0.0.8",
    "redux-thunk": "^2.3.0",
    "reselect": "^4.0.0",
    "riot": "<4",
    "riot-route": "^3.1.4",
    "uss": "^0.0.17"
  },
  "devDependencies": {
    "@babel/core": "^7.4.5",
    "@babel/preset-env": "^7.4.5",
    "@babel/preset-typescript": "^7.4.5",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "autoprefixer": "^9.6.0",
    "babel-loader": "^8.0.6",
    "core-js": "^3.1.4",
    "css-loader": "^3.0.0",
    "file-loader": "^4.0.0",
    "html-webpack-harddisk-plugin": "^1.0.1",
    "html-webpack-plugin": "^3.2.0",
    "jest": "^24.8.0",
    "postcss-loader": "^3.0.0",
    "riot-compiler": "^3.6.0",
    "riot-tag-loader": "^2.1.0",
    "sass": "^1.77.8",
    "sass-loader": "^7.1.0",
    "style-loader": "^0.23.1",
    "typescript": "^5.4.0",
    "webpack": "^4.35.0",
    "webpack-cli": "^3.3.5",
    "webpack-dev-server": "^3.7.2"
  }
}
